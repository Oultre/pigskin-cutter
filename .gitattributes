# Sample frames and small binary fixtures go through LFS.
# Raw film is gitignored entirely and never reaches here.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text

# Keep text files sane across macOS and Windows.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf*.ico  binary
